{
  "expo": {
    "name": "WGAWPT",
    "slug": "imposter-game",
    "scheme": "wgawpt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rak.impostergame",
      "associatedDomains": [
        "applinks:imposter-game-a588f.web.app"
      ]
    },
    "android": {
      "package": "com.rak.wgawpt",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "imposter-game-a588f.web.app",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b808483f-b267-46ae-b19a-87e971c51442"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-font",
      "expo-dev-client",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Lets you talk with your group in voice chat.",
          "cameraPermission": "This app doesn't use the camera for calls."
        }
      ]
    ]
  }
}
