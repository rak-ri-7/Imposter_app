{
  "name": "imposter-game",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:cot": "npx tsx tests/court-of-thieves.test.ts",
    "test:mtf": "npx tsx tests/match-the-following.test.ts",
    "test:rrf": "npx tsx tests/roof-race.test.ts",
    "backup": "node tools/firestore-backup.mjs",
    "restore": "node tools/firestore-restore.mjs"
  },
  "expo": {
    "name": "What Game Are We Playing Today?",
    "slug": "wgawpt",
    "scheme": "wgawpt",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.yourname.wgawpt",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "wgawpt"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.yourname.wgawpt"
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@livekit/react-native": "^3.1.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "^150.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "expo": "^57.0.20",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.13.0",
    "livekit-client": "^2.23.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.2",
    "react-native-qrcode-svg": "^6.3.22",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "firebase-admin": "^13.10.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
